{
  "extends": "@total-typescript/tsconfig/bundler/dom",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "noFallthroughCasesInSwitch": true,
    "allowJs": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "../openapi/generated/schema.d.ts"]
}
