.DS_Store
.env
.env.*
!.env.example

# Rails secrets — never commit. The primary key decrypts credentials.yml.enc,
# which holds secret_key_base (used to sign session cookies).
/api/config/master.key
/api/config/credentials/*.key

/api/.bundle
/api/log/*
!/api/log/.keep
/api/tmp/*
!/api/tmp/.keep
/api/storage/*
!/api/storage/.keep

/web/node_modules
/web/dist
.gstack/
